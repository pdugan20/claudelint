{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pdugan20/claudelint/main/schemas/plugin-manifest.schema.json",
  "title": "Claude Code Plugin Manifest",
  "description": "Schema for plugin.json manifest files in Claude Code plugins",
  "source": "https://code.claude.com/docs/en/plugins-reference#plugin-manifest-schema",
  "sourceType": "documentation",
  "type": "object",
  "required": ["name"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Unique plugin identifier (kebab-case, no spaces). Used as skill namespace prefix.",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "$schema": {
      "type": "string",
      "description": "JSON Schema URL for editor autocomplete and validation. Claude Code ignores this field at load time."
    },
    "version": {
      "type": "string",
      "description": "Version string; semantic versioning is recommended but not required by Claude Code."
    },
    "description": {
      "type": "string",
      "description": "Brief explanation of plugin purpose. Shown in plugin manager."
    },
    "author": {
      "type": "object",
      "description": "Author information (object format required, string format not supported by Claude Code)",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Author name (required)"
        },
        "email": {
          "type": "string",
          "description": "Author email address (optional)",
          "format": "email"
        },
        "url": {
          "type": "string",
          "description": "Author website or profile URL (optional)",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "homepage": {
      "type": "string",
      "description": "Plugin documentation URL",
      "format": "uri"
    },
    "repository": {
      "type": "string",
      "description": "Source code repository URL",
      "format": "uri"
    },
    "license": {
      "type": "string",
      "description": "License identifier (e.g., MIT, Apache-2.0)"
    },
    "keywords": {
      "type": "array",
      "description": "Discovery tags for marketplace search",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "commands": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "argumentHint": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "allowedTools": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        }
      ],
      "description": "Additional command files/directories (supplements default commands/ directory)"
    },
    "agents": {
      "description": "Additional agent files/directories (supplements default agents/ directory)",
      "oneOf": [
        {
          "type": "string",
          "description": "Path to agent file or directory",
          "pattern": "^\\.\\/.*"
        },
        {
          "type": "array",
          "description": "Array of agent file/directory paths",
          "items": {
            "type": "string",
            "pattern": "^\\.\\/.*"
          },
          "minItems": 1
        }
      ]
    },
    "skills": {
      "description": "Additional skill directories (supplements default skills/ directory)",
      "oneOf": [
        {
          "type": "string",
          "description": "Path to skills directory",
          "pattern": "^\\.\\/.*"
        },
        {
          "type": "array",
          "description": "Array of skill directory paths",
          "items": {
            "type": "string",
            "pattern": "^\\.\\/.*"
          },
          "minItems": 1
        }
      ]
    },
    "hooks": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            ]
          }
        }
      ],
      "description": "Hook configuration: path to a hooks.json, array of paths, or an inline hook config object (hooks/hooks.json is auto-loaded). Commands inside an inline object must use ${CLAUDE_PLUGIN_ROOT}, or the hook silently never fires."
    },
    "mcpServers": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            ]
          }
        }
      ],
      "description": "MCP server configuration: path to .mcp.json, array of paths, or inline MCP config object"
    },
    "outputStyles": {
      "description": "Additional output style files/directories",
      "oneOf": [
        {
          "type": "string",
          "description": "Path to output style file or directory",
          "pattern": "^\\.\\/.*"
        },
        {
          "type": "array",
          "description": "Array of output style file/directory paths",
          "items": {
            "type": "string",
            "pattern": "^\\.\\/.*"
          },
          "minItems": 1
        }
      ]
    },
    "lspServers": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "extensionToLanguage": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^\\.[a-z0-9]+$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "transport": {
                "type": "string",
                "enum": ["stdio", "socket"]
              },
              "env": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "initializationOptions": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "settings": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "workspaceFolder": {
                "type": "string"
              },
              "startupTimeout": {
                "type": "number",
                "minimum": 0
              },
              "shutdownTimeout": {
                "type": "number",
                "minimum": 0
              },
              "requestTimeout": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "diagnostics": {
                "type": "boolean"
              },
              "restartOnCrash": {
                "type": "boolean"
              },
              "maxRestarts": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": ["command", "extensionToLanguage"],
            "additionalProperties": false
          }
        },
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "command": {
                      "type": "string",
                      "minLength": 1
                    },
                    "extensionToLanguage": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "pattern": "^\\.[a-z0-9]+$"
                      },
                      "additionalProperties": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "args": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "transport": {
                      "type": "string",
                      "enum": ["stdio", "socket"]
                    },
                    "env": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "initializationOptions": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    },
                    "settings": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    },
                    "workspaceFolder": {
                      "type": "string"
                    },
                    "startupTimeout": {
                      "type": "number",
                      "minimum": 0
                    },
                    "shutdownTimeout": {
                      "type": "number",
                      "minimum": 0
                    },
                    "requestTimeout": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "diagnostics": {
                      "type": "boolean"
                    },
                    "restartOnCrash": {
                      "type": "boolean"
                    },
                    "maxRestarts": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": ["command", "extensionToLanguage"],
                  "additionalProperties": false
                }
              }
            ]
          }
        }
      ]
    },
    "themes": {
      "description": "Color theme files/directories that appear in /theme alongside built-in presets.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\.\\/.*"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\.\\/.*"
          },
          "minItems": 1
        }
      ]
    },
    "monitors": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "when": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "always"
                  },
                  {
                    "type": "string",
                    "pattern": "^on-skill-invoke:.+$"
                  }
                ]
              }
            },
            "required": ["name", "command", "description"],
            "additionalProperties": false
          }
        }
      ],
      "description": "Background Monitor configurations that start automatically when the plugin is active."
    },
    "userConfig": {
      "type": "object",
      "description": "User-configurable values prompted at enable time. Keyed by valid identifier names.",
      "additionalProperties": {
        "$ref": "#/$defs/userConfigOption"
      }
    },
    "channels": {
      "type": "array",
      "description": "Channel declarations that bind to MCP servers for message injection (Telegram, Slack, Discord style).",
      "items": {
        "$ref": "#/$defs/channel"
      }
    },
    "dependencies": {
      "type": "array",
      "description": "Other plugins this plugin requires, optionally with semver version constraints.",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "marketplace": {
                "type": "string",
                "description": "Marketplace to resolve name in. Requires allowCrossMarketplaceDependenciesOn."
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "displayName": {
      "type": "string"
    },
    "defaultEnabled": {
      "type": "boolean"
    },
    "metadata": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "workflows": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "experimental": {
      "type": "object",
      "properties": {
        "themes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "monitors": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "command": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "when": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "always"
                      },
                      {
                        "type": "string",
                        "pattern": "^on-skill-invoke:.+$"
                      }
                    ]
                  }
                },
                "required": ["name", "command", "description"],
                "additionalProperties": false
              }
            }
          ]
        },
        "evals": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "icon": {
      "type": "string"
    },
    "documentationUrl": {
      "type": "string",
      "format": "starts_with",
      "pattern": "^https:\\/\\/.*"
    },
    "supportUrl": {
      "type": "string",
      "format": "starts_with",
      "pattern": "^https:\\/\\/.*"
    },
    "privacyPolicyUrl": {
      "type": "string",
      "format": "starts_with",
      "pattern": "^https:\\/\\/.*"
    },
    "termsOfServiceUrl": {
      "type": "string",
      "format": "starts_with",
      "pattern": "^https:\\/\\/.*"
    },
    "settings": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "string"
        },
        "subagentStatusLine": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "command"
            },
            "command": {
              "type": "string"
            }
          },
          "required": ["type", "command"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "types": {
      "type": "string"
    }
  },
  "$defs": {
    "userConfigOption": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["string", "number", "boolean", "directory", "file"]
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "sensitive": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "multiple": {
          "type": "boolean"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      },
      "required": ["type", "title", "description"],
      "additionalProperties": false
    },
    "channel": {
      "type": "object",
      "properties": {
        "server": {
          "type": "string"
        },
        "userConfig": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["string", "number", "boolean", "directory", "file"]
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "sensitive": {
                "type": "boolean"
              },
              "required": {
                "type": "boolean"
              },
              "default": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "multiple": {
                "type": "boolean"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            },
            "required": ["type", "title", "description"],
            "additionalProperties": false
          }
        }
      },
      "required": ["server"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
