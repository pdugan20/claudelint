{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pdugan20/claudelint/main/schemas/lsp-config.schema.json",
  "title": "Claude Code LSP Configuration",
  "description": "Schema for .lsp.json files that configure Language Server Protocol servers",
  "source": "https://code.claude.com/docs/en/plugins-reference#lsp-servers",
  "sourceType": "documentation",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "properties": {
      "command": {
        "type": "string",
        "minLength": 1
      },
      "extensionToLanguage": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^\\.[a-z0-9]+$"
        },
        "additionalProperties": {
          "type": "string",
          "minLength": 1
        }
      },
      "args": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "transport": {
        "type": "string",
        "enum": ["stdio", "socket"]
      },
      "env": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "string"
        }
      },
      "initializationOptions": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      },
      "settings": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      },
      "workspaceFolder": {
        "type": "string"
      },
      "startupTimeout": {
        "type": "number",
        "minimum": 0
      },
      "shutdownTimeout": {
        "type": "number",
        "minimum": 0
      },
      "requestTimeout": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "diagnostics": {
        "type": "boolean"
      },
      "restartOnCrash": {
        "type": "boolean"
      },
      "maxRestarts": {
        "type": "number",
        "minimum": 0
      }
    },
    "required": ["command", "extensionToLanguage"],
    "additionalProperties": false
  }
}
