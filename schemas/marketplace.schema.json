{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pdugan20/claudelint/main/schemas/marketplace.schema.json",
  "title": "Claude Code Plugin Marketplace",
  "description": "Schema for marketplace.json files in Claude Code plugin marketplaces",
  "source": "https://code.claude.com/docs/en/plugin-marketplaces#marketplace-schema",
  "sourceType": "documentation",
  "type": "object",
  "required": ["name", "owner", "plugins"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference URL"
    },
    "name": {
      "type": "string",
      "description": "Marketplace identifier (kebab-case). Used in install commands: plugin-name@marketplace-name",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "description": "Brief marketplace description"
    },
    "version": {
      "type": "string",
      "description": "Marketplace version"
    },
    "owner": {
      "type": "object",
      "description": "Marketplace maintainer information",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Maintainer or team name"
        },
        "email": {
          "type": "string",
          "description": "Contact email",
          "format": "email"
        }
      },
      "additionalProperties": false
    },
    "plugins": {
      "type": "array",
      "description": "List of available plugins",
      "items": {
        "$ref": "#/$defs/pluginEntry"
      }
    },
    "metadata": {
      "type": "object",
      "description": "Additional marketplace metadata",
      "properties": {
        "description": {
          "type": "string",
          "description": "Brief marketplace description"
        },
        "version": {
          "type": "string",
          "description": "Marketplace version"
        },
        "pluginRoot": {
          "type": "string",
          "description": "Base directory prepended to relative plugin source paths"
        }
      },
      "additionalProperties": false
    },
    "allowCrossMarketplaceDependenciesOn": {
      "type": "array",
      "description": "Other marketplaces that plugins in this marketplace may depend on. Dependencies from a marketplace not listed here are blocked at install.",
      "items": {
        "type": "string"
      }
    },
    "renames": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": ["string", "null"]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "pluginSource": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": ["github", "url", "git-subdir", "npm"]
            },
            "repo": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "package": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "registry": {
              "type": "string"
            },
            "ref": {
              "type": "string"
            },
            "sha": {
              "type": "string"
            }
          },
          "required": ["source"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "archive"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https:\\/\\/.*"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            }
          },
          "required": ["source", "url"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "command"
            },
            "command": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "^(?!.* {4})[\\x20-\\x7E]+$"
            },
            "timeout": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 600
            },
            "mode": {
              "type": "string",
              "enum": ["copy", "link"]
            }
          },
          "required": ["source", "command"],
          "additionalProperties": false
        }
      ]
    },
    "pluginEntry": {
      "type": "object",
      "description": "A plugin listed in the marketplace",
      "required": ["name", "source"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Plugin identifier (kebab-case)"
        },
        "source": {
          "$ref": "#/$defs/pluginSource"
        },
        "description": {
          "type": "string",
          "description": "Brief plugin description"
        },
        "version": {
          "type": "string",
          "description": "Plugin version (semver)"
        },
        "author": {
          "type": "object",
          "description": "Plugin author information",
          "required": ["name"],
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "url": {
              "type": "string",
              "description": "Author URL",
              "format": "uri"
            }
          },
          "additionalProperties": false
        },
        "homepage": {
          "type": "string",
          "description": "Plugin documentation URL",
          "format": "uri"
        },
        "repository": {
          "type": "string",
          "description": "Source code URL",
          "format": "uri"
        },
        "license": {
          "type": "string",
          "description": "SPDX license identifier"
        },
        "keywords": {
          "type": "array",
          "description": "Discovery tags",
          "items": {
            "type": "string"
          }
        },
        "category": {
          "type": "string",
          "description": "Plugin category"
        },
        "tags": {
          "type": "array",
          "description": "Additional tags",
          "items": {
            "type": "string"
          }
        },
        "strict": {
          "type": "boolean",
          "description": "Whether plugin.json is authority for components (default: true)"
        },
        "commands": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^\\.\\/.*"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^\\.\\/.*"
              }
            }
          ]
        },
        "agents": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^\\.\\/.*"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^\\.\\/.*"
              }
            }
          ]
        },
        "skills": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^\\.\\/.*"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^\\.\\/.*"
              }
            }
          ]
        },
        "hooks": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^\\.\\/.*\\.json$"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "mcpServers": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^\\.\\/.*\\.json$"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "object"
            }
          ]
        },
        "outputStyles": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^\\.\\/.*"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^\\.\\/.*"
              }
            }
          ]
        },
        "lspServers": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^\\.\\/.*\\.json$"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "object"
            }
          ]
        },
        "$schema": {
          "type": "string",
          "description": "JSON Schema reference URL"
        },
        "themes": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^\\.\\/.*"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^\\.\\/.*"
              }
            }
          ]
        },
        "monitors": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^\\.\\/.*"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^\\.\\/.*"
              }
            }
          ]
        },
        "userConfig": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/userConfigOption"
          }
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/channel"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  },
                  "marketplace": {
                    "type": "string",
                    "description": "Marketplace to resolve name in. Requires allowCrossMarketplaceDependenciesOn."
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "displayName": {
          "type": "string"
        },
        "defaultEnabled": {
          "type": "boolean"
        },
        "metadata": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "workflows": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "experimental": {
          "type": "object",
          "properties": {
            "themes": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "monitors": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "evals": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "relevance": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "headers": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "headersHelper": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "userConfigOption": {
      "type": "object",
      "required": ["type", "title", "description"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["string", "number", "boolean", "directory", "file"]
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "sensitive": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "default": {},
        "multiple": {
          "type": "boolean"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "channel": {
      "type": "object",
      "required": ["server"],
      "properties": {
        "server": {
          "type": "string"
        },
        "userConfig": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/userConfigOption"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
