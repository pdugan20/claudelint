{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pdugan20/claudelint/main/schemas/marketplace.schema.json",
  "title": "Claude Code Plugin Marketplace",
  "description": "Schema for marketplace.json files in Claude Code plugin marketplaces",
  "source": "https://code.claude.com/docs/en/plugin-marketplaces#marketplace-schema",
  "sourceType": "documentation",
  "type": "object",
  "required": ["name", "owner", "plugins"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference URL"
    },
    "name": {
      "type": "string",
      "description": "Marketplace identifier (kebab-case). Used in install commands: plugin-name@marketplace-name",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "description": "Brief marketplace description"
    },
    "version": {
      "type": "string",
      "description": "Marketplace version"
    },
    "owner": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "plugins": {
      "type": "array",
      "description": "List of available plugins",
      "items": {
        "$ref": "#/$defs/pluginEntry"
      }
    },
    "metadata": {
      "type": "object",
      "description": "Additional marketplace metadata",
      "properties": {
        "description": {
          "type": "string",
          "description": "Brief marketplace description"
        },
        "version": {
          "type": "string",
          "description": "Marketplace version"
        },
        "pluginRoot": {
          "type": "string",
          "description": "Base directory prepended to relative plugin source paths"
        }
      },
      "additionalProperties": false
    },
    "allowCrossMarketplaceDependenciesOn": {
      "type": "array",
      "description": "Other marketplaces that plugins in this marketplace may depend on. Dependencies from a marketplace not listed here are blocked at install.",
      "items": {
        "type": "string"
      }
    },
    "renames": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": ["string", "null"]
      }
    },
    "forceRemoveDeletedPlugins": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "pluginSource": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": ["github", "url", "git-subdir", "npm"]
            },
            "repo": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "package": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "registry": {
              "type": "string"
            },
            "ref": {
              "type": "string"
            },
            "sha": {
              "type": "string"
            }
          },
          "required": ["source"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "archive"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https:\\/\\/.*"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            }
          },
          "required": ["source", "url"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "command"
            },
            "command": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "^(?!.* {4})[\\x20-\\x7E]+$"
            },
            "timeout": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 600
            },
            "mode": {
              "type": "string",
              "enum": ["copy", "link"]
            }
          },
          "required": ["source", "command"],
          "additionalProperties": false
        }
      ]
    },
    "pluginEntry": {
      "type": "object",
      "description": "A plugin listed in the marketplace",
      "required": ["name", "source"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Plugin identifier (kebab-case)"
        },
        "source": {
          "$ref": "#/$defs/pluginSource"
        },
        "description": {
          "type": "string",
          "description": "Brief plugin description"
        },
        "version": {
          "type": "string",
          "description": "Plugin version (semver)"
        },
        "author": {
          "type": "object",
          "description": "Plugin author information",
          "required": ["name"],
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "url": {
              "type": "string",
              "description": "Author URL",
              "format": "uri"
            }
          },
          "additionalProperties": false
        },
        "homepage": {
          "type": "string",
          "description": "Plugin documentation URL",
          "format": "uri"
        },
        "repository": {
          "type": "string",
          "description": "Source code URL",
          "format": "uri"
        },
        "license": {
          "type": "string",
          "description": "SPDX license identifier"
        },
        "keywords": {
          "type": "array",
          "description": "Discovery tags",
          "items": {
            "type": "string"
          }
        },
        "category": {
          "type": "string",
          "description": "Plugin category"
        },
        "tags": {
          "type": "array",
          "description": "Additional tags",
          "items": {
            "type": "string"
          }
        },
        "strict": {
          "type": "boolean",
          "description": "Whether plugin.json is authority for components (default: true)"
        },
        "commands": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "argumentHint": {
                    "type": "string"
                  },
                  "model": {
                    "type": "string"
                  },
                  "allowedTools": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          ]
        },
        "agents": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^\\.\\/.*"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^\\.\\/.*"
              }
            }
          ]
        },
        "skills": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^\\.\\/.*"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^\\.\\/.*"
              }
            }
          ]
        },
        "hooks": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                ]
              }
            }
          ]
        },
        "mcpServers": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                ]
              }
            }
          ]
        },
        "outputStyles": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^\\.\\/.*"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^\\.\\/.*"
              }
            }
          ]
        },
        "lspServers": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "extensionToLanguage": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^\\.[a-z0-9]+$"
                    },
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "transport": {
                    "type": "string",
                    "enum": ["stdio", "socket"]
                  },
                  "env": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "initializationOptions": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  },
                  "settings": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  },
                  "workspaceFolder": {
                    "type": "string"
                  },
                  "startupTimeout": {
                    "type": "number",
                    "minimum": 0
                  },
                  "shutdownTimeout": {
                    "type": "number",
                    "minimum": 0
                  },
                  "requestTimeout": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "diagnostics": {
                    "type": "boolean"
                  },
                  "restartOnCrash": {
                    "type": "boolean"
                  },
                  "maxRestarts": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": ["command", "extensionToLanguage"],
                "additionalProperties": false
              }
            },
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "command": {
                          "type": "string",
                          "minLength": 1
                        },
                        "extensionToLanguage": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string",
                            "pattern": "^\\.[a-z0-9]+$"
                          },
                          "additionalProperties": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "args": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "transport": {
                          "type": "string",
                          "enum": ["stdio", "socket"]
                        },
                        "env": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {
                            "type": "string"
                          }
                        },
                        "initializationOptions": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {}
                        },
                        "settings": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {}
                        },
                        "workspaceFolder": {
                          "type": "string"
                        },
                        "startupTimeout": {
                          "type": "number",
                          "minimum": 0
                        },
                        "shutdownTimeout": {
                          "type": "number",
                          "minimum": 0
                        },
                        "requestTimeout": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "diagnostics": {
                          "type": "boolean"
                        },
                        "restartOnCrash": {
                          "type": "boolean"
                        },
                        "maxRestarts": {
                          "type": "number",
                          "minimum": 0
                        }
                      },
                      "required": ["command", "extensionToLanguage"],
                      "additionalProperties": false
                    }
                  }
                ]
              }
            }
          ]
        },
        "$schema": {
          "type": "string",
          "description": "JSON Schema reference URL"
        },
        "themes": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^\\.\\/.*"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^\\.\\/.*"
              }
            }
          ]
        },
        "monitors": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "command": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "when": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "always"
                      },
                      {
                        "type": "string",
                        "pattern": "^on-skill-invoke:.+$"
                      }
                    ]
                  }
                },
                "required": ["name", "command", "description"],
                "additionalProperties": false
              }
            }
          ]
        },
        "userConfig": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/userConfigOption"
          }
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/channel"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  },
                  "marketplace": {
                    "type": "string",
                    "description": "Marketplace to resolve name in. Requires allowCrossMarketplaceDependenciesOn."
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "displayName": {
          "type": "string"
        },
        "defaultEnabled": {
          "type": "boolean"
        },
        "metadata": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "workflows": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "experimental": {
          "type": "object",
          "properties": {
            "themes": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "monitors": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "command": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "when": {
                        "anyOf": [
                          {
                            "type": "string",
                            "const": "always"
                          },
                          {
                            "type": "string",
                            "pattern": "^on-skill-invoke:.+$"
                          }
                        ]
                      }
                    },
                    "required": ["name", "command", "description"],
                    "additionalProperties": false
                  }
                }
              ]
            },
            "evals": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "relevance": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "headers": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "headersHelper": {
          "type": "string"
        },
        "settings": {
          "type": "object",
          "properties": {
            "agent": {
              "type": "string"
            },
            "subagentStatusLine": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "command"
                },
                "command": {
                  "type": "string"
                }
              },
              "required": ["type", "command"],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "types": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "userConfigOption": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["string", "number", "boolean", "directory", "file"]
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "sensitive": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "multiple": {
          "type": "boolean"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      },
      "required": ["type", "title", "description"],
      "additionalProperties": false
    },
    "channel": {
      "type": "object",
      "properties": {
        "server": {
          "type": "string"
        },
        "userConfig": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["string", "number", "boolean", "directory", "file"]
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "sensitive": {
                "type": "boolean"
              },
              "required": {
                "type": "boolean"
              },
              "default": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "multiple": {
                "type": "boolean"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            },
            "required": ["type", "title", "description"],
            "additionalProperties": false
          }
        }
      },
      "required": ["server"],
      "additionalProperties": false
    }
  }
}
